{
  "name": "@mku1tra/que-harness",
  "version": "0.5.0",
  "description": "What runs que's plugins: the harness schema of que's ontology (deployment), which imports the plugin schema of @mku1tra/que-plugin, and whose type is the contract of a deployment; the reader of a deployment, the source that gives its graph to its root's lint, and the schema of a deployment's own root.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matta-kelly/que.git",
    "directory": "server/harness"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "exports": {
    ".": {
      "@mku1tra/que-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "types",
    "!types/harness/basis.config.ts"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build && cp ../../LICENSE LICENSE"
  },
  "peerDependencies": {
    "@mku1tra/basis": "^0.30.0",
    "@mku1tra/que-plugin": "^0.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
