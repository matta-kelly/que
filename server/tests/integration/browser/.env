# The settings of the test deployment. Nothing here is a secret: each value is
# made up, and it is in git. It has no Langfuse setting, so que sends no trace.

# The models are not real: each request goes to the stand-in (provider.ts),
# which listens at this URL and takes this key.
FIREWORKS_BASE_URL=http://127.0.0.1:4100/inference/v1
FIREWORKS_API_KEY=fw-test

DEV_USER_EMAIL=dev@que.local
DEV_USER_NAME=Dev

# que's own database. `just test` hands the server the password of a database
# container that is there already; this one is for a container it makes.
POSTGRES_PASSWORD=que-test
DATABASE_URL=postgres://que:que-test@127.0.0.1:5433/que
# The text "que-browser-tests-made-up-key-32" in base64.
QUE_CREDENTIALS_KEY=cXVlLWJyb3dzZXItdGVzdHMtbWFkZS11cC1rZXktMzI=
