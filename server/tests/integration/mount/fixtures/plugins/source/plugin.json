{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "source",
  "description": "A connector, with one op and one skill a domain can use.",
  "extensions": {
    "io.github.matta-kelly.que": {
      "format": 1,
      "title": "Source",
      "ops": [
        {
          "name": "find",
          "title": "Find",
          "description": "Find a thing by its code.",
          "input": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "description": "The thing's code"
              }
            },
            "required": [
              "code"
            ]
          }
        }
      ],
      "roles": [],
      "uses": {
        "ops": [],
        "skills": []
      },
      "capabilities": []
    }
  }
}
