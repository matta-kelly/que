{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "notes",
  "description": "A plugin that sits in its deployment's folder, outside que.",
  "extensions": {
    "io.github.matta-kelly.que": {
      "format": 2,
      "title": "Notes",
      "ops": [
        {
          "name": "find",
          "title": "Find",
          "description": "Finds a note by its title.",
          "input": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "description": "The note's title"
              },
              "folder": {
                "description": "The folder the note is in",
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "capability": {
                "description": "The capability the note is about",
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              }
            },
            "required": [
              "title"
            ]
          }
        }
      ],
      "roles": [],
      "uses": {
        "ops": [],
        "skills": []
      },
      "capabilities": [],
      "cases": []
    }
  }
}
