# A deployment's settings and secrets.
# Copy this file to .env in the deployment's folder and fill in the values.
# que reads it when the deployment starts it; nothing of it is kept in que's own folder.

# ============================================
# Model
# ============================================

# "provider:model" string. Switching providers = change this + install that
# provider's @langchain/* package (e.g. together -> @langchain/together-ai)
MODEL=fireworks:accounts/fireworks/models/deepseek-v4p1-flash

# Fireworks API Key
# Get your key at: https://app.fireworks.ai/settings/users/api-keys
FIREWORKS_API_KEY=your-fireworks-api-key-here

# ============================================
# Dev identity (stands in for Cloudflare Access until it's wired in)
# ============================================

DEV_USER_EMAIL=
DEV_USER_NAME=

# ============================================
# Credential store
# Package credentials (e.g. Odoo) are entered on the UI's Connections page
# and stored encrypted in Postgres. Start the database with scripts/db.sh.
# ============================================

POSTGRES_PASSWORD=
DATABASE_URL=postgres://que:<POSTGRES_PASSWORD>@127.0.0.1:5433/que
# 32 bytes, base64 (openssl rand -base64 32). Losing it makes stored credentials unreadable.
QUE_CREDENTIALS_KEY=
