# A deployment's settings and secrets.
# Copy this file to .env in the deployment's folder and fill in the values.
# que reads it when the deployment starts it; nothing of it is kept in que's own folder.

# ============================================
# Model
# ============================================

# A model is a file of its own, listed in `models` in index.ts. This is the
# key of its provider.

# Fireworks API Key
# Get your key at: https://app.fireworks.ai/settings/users/api-keys
FIREWORKS_API_KEY=your-fireworks-api-key-here

# ============================================
# Dev identity (stands in for Cloudflare Access until it's wired in)
# ============================================

DEV_USER_EMAIL=
DEV_USER_NAME=
# A file with the user's own instructions for the agent, such as an agents.md.
# A path that is not absolute is taken from this folder. It is read for each
# run, and only by an agent whose config says `userInstructions: true`. With
# no file named, the text is the one the user saved in Settings > Account.
# DEV_USER_INSTRUCTIONS=./agents.md

# ============================================
# Credential store
# Package credentials (e.g. Odoo) are entered on the UI's Connections page
# and stored encrypted in Postgres. Start the database with scripts/db.sh.
# ============================================

POSTGRES_PASSWORD=
DATABASE_URL=postgres://que:<POSTGRES_PASSWORD>@127.0.0.1:5433/que
# 32 bytes, base64 (openssl rand -base64 32). Losing it makes stored credentials unreadable.
QUE_CREDENTIALS_KEY=

# ============================================
# Traces
# que sends a trace of each run to the deployment's Langfuse when the two keys
# and the URL are set. With none of the three, it sends nothing. One or two of
# the three stops que at startup.
# ./eval sends its runs to the same Langfuse, as one experiment for each agent
# config. With none of the three, it only prints them. One or two of the three
# stops ./eval before any run.
# ============================================

# The URL of the Langfuse. It has no default.
LANGFUSE_BASE_URL=
# The public key of the Langfuse project.
LANGFUSE_PUBLIC_KEY=
# The secret key of the Langfuse project.
LANGFUSE_SECRET_KEY=
# The world the traces are from, such as dev or production. Left out: default.
LANGFUSE_TRACING_ENVIRONMENT=
# error: print a send that failed in the server log. A failed send is silent without it.
# OTEL_LOG_LEVEL=error

# ============================================
# Evals
# ============================================

# The model that judges each run of ./eval: the name of a model config listed
# in `models` in index.ts. It uses the key of that model's provider.
# Empty: no run is judged, and ./eval only prints the runs.
QUE_JUDGE=
