# A deployment's settings and secrets.
# Copy this file to .env in the deployment's folder and fill in the values.
# que reads it when the deployment starts it; nothing of it is kept in que's own folder.

# ============================================
# Identity
# With both Access settings, the Cloudflare Access login decides who is asking:
# que verifies its signed token and takes the email from it. Set them together,
# or set neither.
# ============================================

# The team domain, such as https://your-team.cloudflareaccess.com.
QUE_ACCESS_TEAM_DOMAIN=
# The application's audience tag, from its Access app.
QUE_ACCESS_AUDIENCE=

# Without either Access setting, this fixed dev user decides, for the settings UI
# and for each MCP client. It is a mistake to set it with Access, and que stops
# at startup.
DEV_USER_EMAIL=
DEV_USER_NAME=

# ============================================
# Credential store
# A user's credentials for a service (e.g. Odoo) are entered on the settings UI's
# Connections page and stored encrypted in Postgres. Start the database with
# scripts/db.sh.
# ============================================

POSTGRES_PASSWORD=
DATABASE_URL=postgres://que:<POSTGRES_PASSWORD>@127.0.0.1:5433/que
# 32 bytes, base64 (openssl rand -base64 32). Losing it makes stored credentials unreadable.
QUE_CREDENTIALS_KEY=
