# This deployment's recipes. Each one runs que's own, for this folder.
# QUE_HOME is the folder que is checked out in.

que := env("QUE_HOME")
here := justfile_directory()

# start que for this deployment. The deployment names que; que does not name it
start:
    just --justfile {{que}}/justfile up {{here}}

# stop que, from the deployment that started it
stop:
    just --justfile {{que}}/justfile down

# follow the logs of the agent server and the UI
logs:
    just --justfile {{que}}/justfile logs

# mount this deployment with no .env and no network, from its saved model facts, then type check it and the packages it lists, and run their tests, against que's core
check:
    just --justfile {{que}}/justfile check-deployment {{here}}

# run the cases of this deployment's packages against que, under each of its agent configs, and print what the agent did.
# que has to be up: just start. `--agent <name>`, one or more times, runs only those configs.
# The runs act on the real services: a case that changes data changes real data.
# With the Langfuse settings in .env, the runs are also sent to Langfuse. With none, they are only printed.
eval *args:
    just --justfile {{que}}/justfile eval {{here}} {{args}}
