#!/usr/bin/env bash
# Start que for this deployment. The deployment names que; que does not name it.
# QUE_HOME is the folder que is checked out in.
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
: "${QUE_HOME:?Set QUE_HOME to the folder que is checked out in}"
exec just --justfile "$QUE_HOME/justfile" up "$here"
