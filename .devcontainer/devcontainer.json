// Node runs in this container, so node_modules never lands in the repo folder:
// the folder sits in a notes vault whose indexer reads every file.
// Opens the whole repo: server/ and ui/ are two apps, each with its own node_modules.
// This file is VS Code's. scripts/container.sh, which `just` calls, makes the same container
// with podman alone: a change here is made there too.
{
  "name": "que",
  "build": { "dockerfile": "Dockerfile" },

  // Mount the repo at its host path, so absolute paths baked into caches (.next,
  // tsbuildinfo) and tool output mean the same thing inside the container and out.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",

  // keep-id: map your host user onto the image's `node` user (uid 1000), so files
  // written into the repo from inside stay owned by you.
  // network=host: the browser reaches the UI (3000) and que's server (2024) on
  // localhost, without VS Code's port forwarding.
  "runArgs": ["--userns=keep-id:uid=1000,gid=1000", "--network=host"],
  "remoteUser": "node",
  "updateRemoteUserUID": false,

  "mounts": [
    // Packages live in a podman volume, not the repo folder. One set per checkout
    // (devcontainerId comes from the folder), so a second checkout of que, such as
    // a deployment's pinned one, never installs over this one's. scripts/container.sh
    // names them by a hash of the folder in its place. `just` uses VS Code's container
    // while it sees the folder, and removes it when it makes its own.
    "source=que-node-modules-${devcontainerId},target=${containerWorkspaceFolder}/server/node_modules,type=volume",
    "source=que-ui-node-modules-${devcontainerId},target=${containerWorkspaceFolder}/ui/node_modules,type=volume",
    // The user's cache: Playwright's Chromium and the check's pinned tools, kept
    // across rebuilds. One per checkout too: `playwright install` deletes any
    // browser no link in the cache can still reach, and a link from another
    // checkout's container cannot be reached from this one.
    "source=que-cache-${devcontainerId},target=/home/node/.cache,type=volume",
    // Next.js build cache, thousands of files: keep it out of the repo folder too.
    "source=que-ui-next-${devcontainerId},target=${containerWorkspaceFolder}/ui/.next,type=volume"
  ],

  // New volumes start root-owned: hand it to `node`, then install.
  "postCreateCommand": "sudo chown node:node server/node_modules ui/node_modules ui/.next /home/node/.cache && (cd server && npm ci) && (cd ui && npm ci && npx playwright install chromium)",

  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  }
}
