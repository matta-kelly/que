// Node runs in this container, so node_modules never lands in the repo folder:
// the folder sits in a notes vault whose indexer reads every file.
// Opens the whole repo: server/ and ui/ are two apps, each with its own node_modules.
// This is the one description of que's container: VS Code and scripts/container.sh, which `just`
// calls, both make it from here through the dev container CLI, so a change is made once.
// The image is que's dev image from ghcr (dev-image workflow, from .devcontainer/Containerfile):
// Node 22, Chromium, and the npm cache of both apps' lockfiles.
{
  "name": "que",
  // A tag the machine has is never pulled by the CLI, so initializeCommand pulls it on the host
  // before the image is resolved. A failed pull does not fail the start: it says so, and the CLI
  // uses the copy this machine has.
  "image": "ghcr.io/matta-kelly/que-dev:main",
  "initializeCommand": "podman pull ghcr.io/matta-kelly/que-dev:main || echo 'could not pull ghcr.io/matta-kelly/que-dev:main: the copy this machine has is used' >&2",

  // Mount the repo at its host path, so absolute paths baked into caches (.next,
  // tsbuildinfo) and tool output mean the same thing inside the container and out.
  "workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
  "workspaceFolder": "${localWorkspaceFolder}",

  // keep-id: map your host user onto the image's `node` user (uid 1000), so files
  // written into the repo from inside stay owned by you.
  // network=host: the browser reaches the UI (3000) and que's server (2024) on
  // localhost, without VS Code's port forwarding. --init stops the container at once
  // on `podman stop`, which `sleep` as the first process would not. The CPU budget
  // bounds this checkout's container: 3 CPUs, and its shares when the host is contended.
  "runArgs": ["--userns=keep-id:uid=1000,gid=1000", "--security-opt", "label=disable", "--network=host", "--init", "--cpus=3", "--cpu-shares=256"],
  "remoteUser": "node",
  "updateRemoteUserUID": false,

  "mounts": [
    // Packages live in a podman volume, not the repo folder. One set per checkout
    // (devcontainerId comes from the folder), so a second checkout of que, such as
    // a deployment's pinned one, never installs over this one's. The CLI names them,
    // so `just` and VS Code mount the same set. `just` uses VS Code's container while
    // it sees the folder, and makes one when it cannot.
    "source=que-node-modules-${devcontainerId},target=${containerWorkspaceFolder}/server/node_modules,type=volume",
    "source=que-ui-node-modules-${devcontainerId},target=${containerWorkspaceFolder}/ui/node_modules,type=volume",
    // The user's cache: the check's pinned tools, kept across rebuilds. Chromium
    // is in the image, at PLAYWRIGHT_BROWSERS_PATH, so it is not here.
    "source=que-cache-${devcontainerId},target=/home/node/.cache,type=volume",
    // Next.js build cache, thousands of files: keep it out of the repo folder too.
    "source=que-ui-next-${devcontainerId},target=${containerWorkspaceFolder}/ui/.next,type=volume"
  ],

  // New volumes start root-owned: hand it to `node`, then install from the image's cache.
  "postCreateCommand": "sudo chown node:node server/node_modules ui/node_modules ui/.next /home/node/.cache && (cd server && npm ci) && (cd ui && npm ci)",

  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  }
}
